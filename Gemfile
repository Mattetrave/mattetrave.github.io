source 'https://rubygems.org'

# Usa il motore Jekyll moderno, compatibile con Liquid aggiornato
gem 'jekyll', '~> 4.3.3'
gem 'liquid', '~> 4.0.4'

# Plugin richiesti dal tema AcademicPages
group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'jekyll-paginate'
  gem 'jekyll-gist'
  gem 'jekyll-include-cache'
  gem 'jekyll-remote-theme'
end

# Componenti mancanti in Ruby > 3.4
gem 'webrick', '~> 1.8'
gem 'csv', '~> 3.3'
gem 'bigdecimal', '~> 4.1'
gem 'tzinfo-data', '~> 1.2026'